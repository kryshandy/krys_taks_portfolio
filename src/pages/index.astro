---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Lab from '../components/Lab.astro';
import Activity from '../components/Activity.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import GitHubStats from '../components/GitHubStats.astro';
import { SOCIAL_LINKS, PERSONAL_INFO } from '../utils/constants';
---
<MainLayout
  title={PERSONAL_INFO.fullName + " — Concepteur Logiciel & IA"}
  description={PERSONAL_INFO.bioShort}
  canonical="https://kryshandy.com/"
>
  <Hero
    ctaPrimary={{ label: "Voir mes réalisations", href: "#realisations" }}
    ctaSecondary={{ label: "Me contacter", href: "#contact" }}
    socialLinks={SOCIAL_LINKS}
  />
  <Profile />
  <Projects />
  <Skills />
  <Experience />
  <Lab />
  <Activity />
  <GitHubStats />
  <Testimonials />
  <Contact />
</MainLayout>
