---
import { Icon } from 'astro-icon/components';

interface GitHubUser {
  login: string;
  name: string;
  avatar_url: string;
  bio: string;
  public_repos: number;
  followers: number;
  following: number;
  created_at: string;
  twitter_username: string | null;
  location: string | null;
  blog: string | null;
  contributions?: number;
}

interface GitHubRepo {
  name: string;
  description: string | null;
  stargazers_count: number;
  forks_count: number;
  language: string | null;
  html_url: string;
  updated_at: string;
  topics: string[];
}

async function fetchGitHubData() {
  const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'krys-portfolio-build',
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
  };

  try {
    const [userRes, reposRes] = await Promise.all([
      fetch('https://api.github.com/users/kryshandy', { headers }),
      fetch('https://api.github.com/users/kryshandy/repos?sort=updated&per_page=6', { headers }),
    ]);

    if (!userRes.ok || !reposRes.ok) return null;

    const user: GitHubUser = await userRes.json();
    const repos: GitHubRepo[] = await reposRes.json();

    const totalStars = repos.reduce((acc, r) => acc + r.stargazers_count, 0);
    const totalForks = repos.reduce((acc, r) => acc + r.forks_count, 0);
    const languages = [...new Set(repos.map(r => r.language).filter(Boolean))];

    return { user, repos, totalStars, totalForks, languages };
  } catch {
    return null;
  }
}

const data = await fetchGitHubData();
---

<section id="github-stats" class="section bg-background">
  <div class="container-premium">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <span
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/50 bg-surface/50 px-3 py-1 text-caption font-medium text-muted-foreground"
      >
        <Icon name="lucide:github" class="h-4 w-4 text-primary" aria-hidden="true" />
        Activité GitHub en Temps Réel
      </span>
      <h2 class="mb-4 font-display text-display-md font-bold tracking-tight text-foreground">
        Mon empreinte open-source
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        Statistiques synchronisées depuis l'API GitHub — Mises à jour à chaque build.
      </p>
    </header>

    {
      data ? (
        <>
          <div class="card-premium-elevated mx-auto mb-8 max-w-4xl p-6 sm:p-8">
            <div class="flex flex-col items-start gap-6 md:flex-row md:items-center">
              <img
                src={data.user.avatar_url}
                alt={data.user.name || data.user.login}
                width="112"
                height="112"
                loading="lazy"
                class="h-24 w-24 rounded-2xl border border-border/40 shadow-lg md:h-28 md:w-28"
              />
              <div class="flex-1 text-center md:text-left">
                <div class="mb-2 flex items-center justify-center gap-3 md:justify-start">
                  <h3 class="text-heading-lg font-bold text-foreground">
                    {data.user.name || data.user.login}
                  </h3>
                  <a
                    href={`https://github.com/${data.user.login}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-ghost px-3 py-1.5 text-caption"
                  >
                    <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                    Voir le profil
                  </a>
                </div>
                <p class="mx-auto mb-4 max-w-xl text-body text-muted-foreground/90 md:mx-0">
                  {data.user.bio ||
                    "Développeur passionné par l'IA offline-first, la cybersécurité et l'impact social."}
                </p>
                <div class="flex flex-wrap items-center justify-center gap-4 text-caption text-muted-foreground md:justify-start">
                  {data.user.location && (
                    <span class="flex items-center gap-1.5">
                      <Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
                      {data.user.location}
                    </span>
                  )}
                  <span class="flex items-center gap-1.5">
                    <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
                    Membre depuis {new Date(data.user.created_at).getFullYear()}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="card-premium group p-6 text-center">
              <div class="mb-1 font-display text-3xl font-bold text-primary transition-transform group-hover:scale-110 sm:text-4xl">
                {data.user.public_repos}
              </div>
              <div class="text-caption text-muted-foreground">Repositories Publics</div>
            </div>
            <div class="card-premium group p-6 text-center">
              <div class="mb-1 font-display text-3xl font-bold text-accent transition-transform group-hover:scale-110 sm:text-4xl">
                {data.totalStars}
              </div>
              <div class="text-caption text-muted-foreground">Étoiles Total</div>
            </div>
            <div class="card-premium group p-6 text-center">
              <div class="mb-1 font-display text-3xl font-bold text-emerald-400 transition-transform group-hover:scale-110 sm:text-4xl">
                {data.totalForks}
              </div>
              <div class="text-caption text-muted-foreground">Forks Total</div>
            </div>
            <div class="card-premium group p-6 text-center">
              <div class="mb-1 font-display text-3xl font-bold text-sky-400 transition-transform group-hover:scale-110 sm:text-4xl">
                {data.user.followers}
              </div>
              <div class="text-caption text-muted-foreground">Followers</div>
            </div>
          </div>

          <div class="card-premium mb-8 p-6 sm:p-7">
            <h3 class="mb-5 flex items-center gap-2 text-heading-sm font-bold text-foreground">
              <Icon name="lucide:code" class="h-5 w-5 text-primary" />
              Langages Les Plus Utilisés
            </h3>
            <div class="flex flex-wrap gap-2">
              {data.languages.slice(0, 10).map(lang => (
                <span class="rounded-xl border border-border/40 bg-surface/60 px-3 py-1.5 font-mono text-caption text-foreground">
                  {lang}
                </span>
              ))}
            </div>
          </div>

          <div class="card-premium p-6 sm:p-7">
            <h3 class="mb-5 flex items-center gap-2 text-heading-sm font-bold text-foreground">
              <Icon name="lucide:folder-git" class="h-5 w-5 text-primary" />
              Dépôts Récents & Mis à Jour
            </h3>
            <div class="space-y-4">
              {data.repos.slice(0, 5).map(repo => (
                <article class="group rounded-xl border border-border/40 bg-surface/60 p-4 transition-colors hover:border-primary/30">
                  <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                    <div class="min-w-0 flex-1">
                      <div class="mb-1.5 flex items-center gap-2.5">
                        <a
                          href={repo.html_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-heading-sm font-bold text-foreground transition-colors hover:text-primary group-hover:underline"
                        >
                          {repo.name}
                        </a>
                        <span class="font-mono text-micro text-muted-foreground">
                          Mis à jour {new Date(repo.updated_at).toLocaleDateString('fr-FR')}
                        </span>
                      </div>
                      {repo.description && (
                        <p class="line-clamp-2 text-body-sm text-muted-foreground/90">
                          {repo.description}
                        </p>
                      )}
                      {repo.topics.length > 0 && (
                        <div class="mt-2 flex flex-wrap gap-1.5">
                          {repo.topics.slice(0, 4).map(topic => (
                            <span class="rounded border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-micro text-primary">
                              {topic}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                    <div class="flex shrink-0 items-center gap-4 text-caption text-muted-foreground">
                      {repo.language && (
                        <span class="flex items-center gap-1.5">
                          <span class="h-2.5 w-2.5 rounded-full bg-primary" />
                          {repo.language}
                        </span>
                      )}
                      <span class="flex items-center gap-1.5">
                        <Icon name="lucide:star" class="h-3.5 w-3.5 text-accent" />
                        {repo.stargazers_count}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <Icon name="lucide:git-fork" class="h-3.5 w-3.5 text-sky-400" />
                        {repo.forks_count}
                      </span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <div class="mt-6 text-center">
              <a
                href="https://github.com/kryshandy?tab=repositories"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline inline-flex items-center gap-2"
              >
                <Icon name="lucide:github" class="h-4 w-4" />
                Voir tous les dépôts
              </a>
            </div>
          </div>
        </>
      ) : (
        <div class="card-premium p-8 text-center">
          <Icon name="lucide:github" class="mx-auto mb-4 h-12 w-12 text-muted-foreground" />
          <h3 class="mb-2 text-heading-sm font-semibold text-foreground">
            Impossible de charger les stats GitHub
          </h3>
          <p class="text-body-sm text-muted-foreground">
            L'API GitHub n'est pas accessible pour le moment. Réessayez plus tard.
          </p>
          <a
            href="https://github.com/kryshandy"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary mt-4 inline-flex items-center gap-2"
          >
            <Icon name="lucide:external-link" class="h-4 w-4" />
            Voir le profil directement
          </a>
        </div>
      )
    }
  </div>
</section>
