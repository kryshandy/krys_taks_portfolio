---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { SKILL_CATEGORIES } from '../utils/constants';

const skills = await getCollection('skills');
const groupedSkills = SKILL_CATEGORIES.map(cat => ({
  ...cat,
  items: skills
    .filter(s => s.data.category === cat.key)
    .sort((a, b) => a.data.order - b.data.order),
})).filter(cat => cat.items.length > 0);
---

<section id="competences" class="section bg-background">
  <div class="container-premium">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/50 bg-surface/50 px-3 py-1 text-caption font-medium text-muted-foreground"
      >
        <Icon name="lucide:cpu" class="h-4 w-4 text-primary" aria-hidden="true" />
        Compétences & Savoir-Faire
      </span>
      <h2 class="mb-4 font-display text-display-md font-bold tracking-tight text-foreground">
        Un socle technique polyvalent et exigeant
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        De la programmation système et mobile à l'intelligence artificielle embarquée et la sécurité
        réseau.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        groupedSkills.map(cat => (
          <article class="card-premium-elevated group flex flex-col justify-between p-6 sm:p-7">
            <div>
              <div class="mb-6 flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-colors group-hover:bg-primary/20">
                  <Icon name={cat.icon} class="h-6 w-6" aria-hidden="true" />
                </div>
                <h3 class="text-heading-sm font-bold text-foreground">{cat.label}</h3>
              </div>

              <div class="space-y-4">
                {cat.items.map(skill => (
                  <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-body-sm">
                      <span class="font-medium text-foreground">{skill.data.name}</span>
                      <span class="font-mono text-caption font-semibold text-primary">
                        {skill.data.level}/5
                      </span>
                    </div>
                    <div class="h-2 overflow-hidden rounded-full bg-surface-sunken">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-primary to-accent transition-all duration-500 ease-spring"
                        style={{ width: `${(skill.data.level / 5) * 100}%` }}
                      />
                    </div>
                    {skill.data.description && (
                      <p class="text-caption leading-relaxed text-muted-foreground">
                        {skill.data.description}
                      </p>
                    )}
                    {skill.data.tags && (
                      <div class="flex flex-wrap gap-1 pt-1">
                        {skill.data.tags.map((tag: string) => (
                          <span class="rounded border border-border/30 bg-surface/80 px-2 py-0.5 font-mono text-micro text-muted-foreground">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Principes d'ingénierie -->
    <div class="card-premium mt-16 p-6 sm:p-8">
      <h3 class="mb-6 flex items-center gap-2 text-heading-md font-bold text-foreground">
        <Icon name="lucide:check-check" class="h-5 w-5 text-primary" />
        Mes principes d'ingénierie logicielle
      </h3>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border/30 bg-surface/50 p-4">
          <Icon name="lucide:wifi-off" class="mb-2 h-6 w-6 text-primary" />
          <h4 class="mb-1 text-body font-semibold text-foreground">Offline-First</h4>
          <p class="text-caption text-muted-foreground">
            Une application doit fonctionner même quand le réseau fait défaut. Le cloud est un
            renfort, pas une dépendance obligatoire.
          </p>
        </div>
        <div class="rounded-xl border border-border/30 bg-surface/50 p-4">
          <Icon name="lucide:shield" class="mb-2 h-6 w-6 text-accent" />
          <h4 class="mb-1 text-body font-semibold text-foreground">Sécurité By Design</h4>
          <p class="text-caption text-muted-foreground">
            Cloisonnement des rôles, chiffrement local, validation stricte et conformité aux
            standards de protection industrielle.
          </p>
        </div>
        <div class="rounded-xl border border-border/30 bg-surface/50 p-4">
          <Icon name="lucide:zap" class="mb-2 h-6 w-6 text-emerald-400" />
          <h4 class="mb-1 text-body font-semibold text-foreground">Sobriété & Performance</h4>
          <p class="text-caption text-muted-foreground">
            Pas de frameworks pachydermiques inutiles. Le code doit s'exécuter avec une latence
            minimale sur du matériel standard.
          </p>
        </div>
        <div class="rounded-xl border border-border/30 bg-surface/50 p-4">
          <Icon name="lucide:users" class="mb-2 h-6 w-6 text-sky-400" />
          <h4 class="mb-1 text-body font-semibold text-foreground">Impact Humain</h4>
          <p class="text-caption text-muted-foreground">
            La technologie tire sa noblesse de son utilité sociale : inclusion des personnes
            vulnérables, santé et sécurité civile.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
