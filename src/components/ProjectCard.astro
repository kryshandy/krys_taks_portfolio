---
import { Icon } from 'astro-icon/components';
import { getProjectTypeColor, cn } from '../utils/helpers';
import { PROJECT_TYPES } from '../utils/constants';

const typeMap = Object.fromEntries(PROJECT_TYPES.map(t => [t.key, t]));

interface Props {
  project: any;
  featured: boolean;
}

const { project, featured } = Astro.props;
---

<article
  class={cn(
    'card-premium p-6 sm:p-7 flex flex-col h-full group',
    featured && 'card-premium-elevated border-primary/20 hover:border-primary/50'
  )}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <span class={cn('badge shrink-0', getProjectTypeColor(project.data.type))}>
      <Icon
        name={typeMap[project.data.type]?.icon || 'lucide:code'}
        class="h-3.5 w-3.5"
        aria-hidden="true"
      />
      {typeMap[project.data.type]?.label || project.data.type}
    </span>
    <div class="flex items-center gap-2">
      {
        project.data.highlight && (
          <span class="badge-accent shrink-0">
            <Icon name="lucide:trophy" class="h-3 w-3" aria-hidden="true" />
            Mise en avant
          </span>
        )
      }
      <span class="font-mono text-caption text-muted-foreground">{project.data.year}</span>
    </div>
  </div>

  <h4
    class="mb-2 text-heading-md font-bold text-foreground transition-colors group-hover:text-primary"
  >
    {project.data.title}
  </h4>
  <p class="mb-4 flex-1 text-body-sm leading-relaxed text-muted-foreground/90">
    {project.data.description}
  </p>

  {
    project.data.metrics && project.data.metrics.length > 0 && (
      <div class="mb-4 grid grid-cols-3 gap-2 rounded-xl border border-border/40 bg-surface/60 px-3.5 py-3">
        {project.data.metrics.slice(0, 3).map((m: any) => (
          <div class="text-center">
            <div class="text-caption font-bold text-primary">{m.value}</div>
            <div class="truncate text-micro text-muted-foreground">{m.label}</div>
          </div>
        ))}
      </div>
    )
  }

  <div class="mb-5 flex flex-wrap gap-1.5" aria-label="Technologies employées">
    {
      project.data.stack.map((tech: string) => (
        <span class="rounded-lg border border-border/50 bg-surface/50 px-2.5 py-1 text-caption font-medium text-muted-foreground">
          {tech}
        </span>
      ))
    }
  </div>

  <div class="mt-auto flex items-center justify-between gap-3 border-t border-border/40 pt-4">
    <div class="flex items-center gap-2 text-caption text-muted-foreground">
      {
        project.data.status === 'production' && (
          <span class="flex items-center gap-1 font-medium text-emerald-400">
            <span class="h-2 w-2 rounded-full bg-emerald-400" />
            Production
          </span>
        )
      }
      {
        project.data.status === 'development' && (
          <span class="flex items-center gap-1 font-medium text-amber-400">
            <span class="h-2 w-2 rounded-full bg-amber-400" />
            Actif
          </span>
        )
      }
      {
        project.data.status === 'beta' && (
          <span class="flex items-center gap-1 font-medium text-sky-400">
            <span class="h-2 w-2 rounded-full bg-sky-400" />
            Beta
          </span>
        )
      }
    </div>

    <div class="flex items-center gap-2">
      {
        project.data.repoUrl && (
          <a
            href={project.data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost flex items-center gap-1.5 px-3 py-1.5 text-caption"
            aria-label={'Code source de ' + project.data.title}
          >
            <Icon name="lucide:github" class="h-3.5 w-3.5" />
            Code
          </a>
        )
      }
      {
        project.data.demoUrl && (
          <a
            href={project.data.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary flex items-center gap-1.5 px-3 py-1.5 text-caption"
          >
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
            Démo
          </a>
        )
      }
    </div>
  </div>
</article>
