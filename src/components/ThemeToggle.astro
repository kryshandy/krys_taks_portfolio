---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-label="Basculer le mode clair ou sombre"
  aria-pressed="false"
  class="relative rounded-xl border border-border/50 bg-surface/50 p-2.5 text-muted-foreground transition-all duration-200 ease-smooth hover:border-primary/40 hover:bg-primary/5 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
>
  <span class="sr-only">Changer le thème</span>
  <Icon
    name="lucide:sun"
    class="h-4 w-4 rotate-0 scale-100 transition-transform duration-300 ease-spring dark:-rotate-90 dark:scale-0"
    aria-hidden="true"
  />
  <Icon
    name="lucide:moon"
    class="absolute inset-0 m-auto h-4 w-4 rotate-90 scale-0 transition-transform duration-300 ease-spring dark:rotate-0 dark:scale-100"
    aria-hidden="true"
  />
</button>

<script is:inline>
  (function () {
    var toggle = document.getElementById('theme-toggle');
    var html = document.documentElement;

    function updateState(isLight) {
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(!isLight));
      var sr = toggle.querySelector('.sr-only');
      if (sr) sr.textContent = isLight ? 'Passer en mode sombre' : 'Passer en mode clair';
    }

    function apply(isLight) {
      if (isLight) {
        html.classList.add('light');
        html.classList.remove('dark');
      } else {
        html.classList.add('dark');
        html.classList.remove('light');
      }
      updateState(isLight);
    }

    try {
      var isLight = localStorage.getItem('theme') === 'light';
      apply(isLight);
    } catch {}

    if (toggle) {
      toggle.addEventListener('click', function () {
        var isLightNow = html.classList.contains('light');
        var nextIsLight = !isLightNow;
        apply(nextIsLight);
        try {
          localStorage.setItem('theme', nextIsLight ? 'light' : 'dark');
        } catch {}
      });
    }
  })();
</script>
