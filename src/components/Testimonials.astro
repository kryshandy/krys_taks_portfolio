---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getInitials } from '../utils/helpers';

const testimonials = await getCollection('testimonials');
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
---
<section class="section bg-background">
  <div class="container-premium">
    <header class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border/50 bg-surface/50 text-caption font-medium text-muted-foreground mb-4">
        <Icon name="lucide:message-square-quote" class="w-4 h-4 text-primary" aria-hidden="true" />
        Témoignages & Évaluations
      </span>
      <h2 class="text-display-md font-display font-bold tracking-tight text-foreground mb-4">
        Ce que disent ceux qui ont collaboré avec moi
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        Retours du jury de hackathon, de pairs développeurs et de mentors sur ma méthode de travail et mon engagement.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-3 max-w-6xl mx-auto">
      {sortedTestimonials.map((t) => (
        <article key={t.id} class="card-premium-elevated p-6 sm:p-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3.5 mb-5">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary/20 to-accent/20 border border-primary/30 flex items-center justify-center font-display font-bold text-primary text-body">
                {getInitials(t.data.author)}
              </div>
              <div>
                <h4 class="text-body font-bold text-foreground">{t.data.author}</h4>
                <p class="text-caption text-muted-foreground">{t.data.role}</p>
                {t.data.company && (
                  <p class="text-caption text-primary font-medium">{t.data.company}</p>
                )}
              </div>
            </div>

            <Icon name="lucide:quote" class="w-7 h-7 text-primary/40 mb-3" />
            <blockquote class="text-body-sm text-muted-foreground/90 italic leading-relaxed">
              "{t.data.content}"
            </blockquote>
          </div>

          <div class="pt-5 mt-5 border-t border-border/40 flex items-center justify-between text-caption text-muted-foreground">
            <span>{t.data.date}</span>
            {t.data.project && (
              <span class="badge-primary text-caption font-mono">
                {t.data.project}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
