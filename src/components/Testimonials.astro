---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getInitials } from '../utils/helpers';

const testimonials = await getCollection('testimonials');
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
---

<section class="section bg-background">
  <div class="container-premium">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/50 bg-surface/50 px-3 py-1 text-caption font-medium text-muted-foreground"
      >
        <Icon name="lucide:message-square-quote" class="h-4 w-4 text-primary" aria-hidden="true" />
        Témoignages & Évaluations
      </span>
      <h2 class="mb-4 font-display text-display-md font-bold tracking-tight text-foreground">
        Ce que disent ceux qui ont collaboré avec moi
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        Retours du jury de hackathon, de pairs développeurs et de mentors sur ma méthode de travail
        et mon engagement.
      </p>
    </header>

    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
      {
        sortedTestimonials.map(t => (
          <article class="card-premium-elevated flex flex-col justify-between p-6 sm:p-7">
            <div>
              <div class="mb-5 flex items-center gap-3.5">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-primary/30 bg-gradient-to-br from-primary/20 to-accent/20 font-display text-body font-bold text-primary">
                  {getInitials(t.data.author)}
                </div>
                <div>
                  <h4 class="text-body font-bold text-foreground">{t.data.author}</h4>
                  <p class="text-caption text-muted-foreground">{t.data.role}</p>
                  {t.data.company && (
                    <p class="text-caption font-medium text-primary">{t.data.company}</p>
                  )}
                </div>
              </div>

              <Icon name="lucide:quote" class="mb-3 h-7 w-7 text-primary/40" />
              <blockquote class="text-body-sm italic leading-relaxed text-muted-foreground/90">
                "{t.data.content}"
              </blockquote>
            </div>

            <div class="mt-5 flex items-center justify-between border-t border-border/40 pt-5 text-caption text-muted-foreground">
              <span>{t.data.date}</span>
              {t.data.project && (
                <span class="badge-primary font-mono text-caption">{t.data.project}</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
