---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { formatDate } from '../utils/helpers';

const activities = await getCollection('activities');
const sortedActivities = activities.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const typeIcons: Record<string, string> = {
  commit: 'lucide:git-commit',
  release: 'lucide:package',
  article: 'lucide:file-text',
  talk: 'lucide:mic',
  milestone: 'lucide:flag',
  learning: 'lucide:graduation-cap',
  certification: 'lucide:award',
};

const typeLabels: Record<string, string> = {
  commit: 'Commit',
  release: 'Release',
  article: 'Article',
  talk: 'Prise de parole',
  milestone: 'Étape majeure',
  learning: 'Laboratoire',
  certification: 'Certification',
};
---

<section id="activite" class="section bg-surface/30">
  <div class="container-premium">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/50 bg-surface/50 px-3 py-1 text-caption font-medium text-muted-foreground"
      >
        <Icon name="lucide:activity" class="h-4 w-4 text-primary" aria-hidden="true" />
        Journal d'Activité
      </span>
      <h2 class="mb-4 font-display text-display-md font-bold tracking-tight text-foreground">
        Veille, jalons techniques et distinctions
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        Les dernières avancées sur mes projets, mes certifications validées et mes participations
        aux compétitions.
      </p>
    </header>

    <div class="relative mx-auto max-w-3xl">
      <div
        class="absolute bottom-0 left-6 top-0 w-px bg-gradient-to-b from-primary via-border to-transparent sm:left-8"
        aria-hidden="true"
      >
      </div>

      <dl class="space-y-8" role="list">
        {
          sortedActivities.map(act => (
            <div class="group relative flex gap-5 sm:gap-6" role="listitem">
              <div class="relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl border border-border/50 bg-card shadow-sm transition-colors group-hover:border-primary">
                <Icon
                  name={typeIcons[act.data.type] || 'lucide:circle'}
                  class="h-5 w-5 text-primary"
                  aria-hidden="true"
                />
              </div>

              <div class="min-w-0 flex-1 pt-1">
                <div class="card-premium p-5 sm:p-6">
                  <div class="mb-2 flex flex-wrap items-center gap-2.5">
                    <span class="badge-primary font-mono text-caption">
                      <Icon name={typeIcons[act.data.type] || 'lucide:circle'} class="h-3 w-3" />
                      {typeLabels[act.data.type] || act.data.type}
                    </span>
                    <time
                      class="font-mono text-caption text-muted-foreground"
                      datetime={act.data.date}
                    >
                      {formatDate(act.data.date)}
                    </time>
                    {act.data.project && (
                      <span class="badge text-caption font-medium">{act.data.project}</span>
                    )}
                  </div>

                  <h3 class="mb-1.5 text-heading-sm font-bold text-foreground">{act.data.title}</h3>
                  {act.data.description && (
                    <p class="mb-3 text-body-sm leading-relaxed text-muted-foreground/90">
                      {act.data.description}
                    </p>
                  )}

                  {act.data.tags && (
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {act.data.tags.map((tag: string) => (
                        <span class="rounded border border-border/30 bg-surface px-2 py-0.5 font-mono text-micro text-muted-foreground">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class="mt-3 flex items-center gap-3">
                    {act.data.repo && (
                      <a
                        href={act.data.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-ghost flex items-center gap-1.5 px-3 py-1 text-caption"
                      >
                        <Icon name="lucide:github" class="h-3.5 w-3.5" />
                        Voir le code
                      </a>
                    )}
                    {act.data.url && (
                      <a
                        href={act.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-ghost flex items-center gap-1.5 px-3 py-1 text-caption text-primary"
                      >
                        <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                        En savoir plus
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
