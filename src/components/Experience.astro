---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { formatDate } from '../utils/helpers';

const experience = await getCollection('experience');
const sortedExp = experience.sort((a, b) => a.data.order - b.data.order);
---

<section id="parcours" class="section bg-surface/30">
  <div class="container-premium">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-border/50 bg-surface/50 px-3 py-1 text-caption font-medium text-muted-foreground"
      >
        <Icon name="lucide:briefcase" class="h-4 w-4 text-primary" aria-hidden="true" />
        Parcours & Formation
      </span>
      <h2 class="mb-4 font-display text-display-md font-bold tracking-tight text-foreground">
        Une trajectoire guidée par la rigueur et l'audace
      </h2>
      <p class="text-body-lg text-muted-foreground/90">
        De la maintenance informatique et l'obtention du GCE Advanced Level jusqu'à la Licence en IA
        et le lead technique de solutions sociétales.
      </p>
    </header>

    <div class="relative mx-auto max-w-4xl">
      <div
        class="absolute bottom-0 left-6 top-0 w-px bg-gradient-to-b from-primary via-border to-transparent sm:left-8"
        aria-hidden="true"
      >
      </div>

      <dl class="space-y-10" role="list">
        {
          sortedExp.map(exp => (
            <div class="group relative flex gap-5 sm:gap-8" role="listitem">
              <div class="relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl border border-border/50 bg-card shadow-md transition-colors group-hover:border-primary sm:h-16 sm:w-16">
                <div class="h-3 w-3 rounded-full bg-primary transition-transform group-hover:scale-125" />
              </div>

              <div class="min-w-0 flex-1 pt-1">
                <div class="card-premium p-6 sm:p-7">
                  <div class="mb-3 flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <div class="mb-2 flex flex-wrap items-center gap-2">
                        <span class="badge-primary font-mono text-caption">
                          {formatDate(exp.data.startDate)} –{' '}
                          {exp.data.current ? 'Présent' : formatDate(exp.data.endDate!)}
                        </span>
                        {exp.data.current && (
                          <span class="badge-success text-caption">En cours</span>
                        )}
                      </div>
                      <h3 class="mb-1 text-heading-md font-bold text-foreground">
                        {exp.data.role}
                      </h3>
                      <p class="text-body font-semibold text-primary">{exp.data.company}</p>
                      <p class="mt-1 flex items-center gap-1 text-caption text-muted-foreground">
                        <Icon name="lucide:map-pin" class="h-3.5 w-3.5" />
                        {exp.data.location}
                      </p>
                    </div>
                  </div>

                  <p class="mb-4 text-body-sm leading-relaxed text-muted-foreground/90">
                    {exp.data.description}
                  </p>

                  <ul class="mb-4 space-y-2" role="list">
                    {exp.data.achievements.map(item => (
                      <li class="flex items-start gap-2.5 text-body-sm text-muted-foreground">
                        <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>

                  {exp.data.stack && (
                    <div class="flex flex-wrap gap-1.5 border-t border-border/30 pt-2">
                      {exp.data.stack.map(tech => (
                        <span class="rounded-lg border border-border/40 bg-surface/60 px-2.5 py-1 font-mono text-caption text-muted-foreground">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
