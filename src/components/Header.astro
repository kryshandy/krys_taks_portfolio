---
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { PERSONAL_INFO, NAV_ITEMS } from '../utils/constants';
---

<header
  class="fixed left-0 right-0 top-0 z-[100] border-b border-border/40 bg-background/80 backdrop-blur-xl"
>
  <nav class="container-premium" aria-label="Navigation principale">
    <div class="flex h-16 items-center justify-between gap-4">
      <a
        href="#accueil"
        class="flex items-center gap-3 text-foreground transition-opacity hover:opacity-80"
        aria-label="Accueil"
      >
        <div
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 font-display text-heading-sm font-extrabold text-primary"
        >
          {PERSONAL_INFO.monogram}
        </div>
        <span class="hidden font-display text-body-sm font-bold leading-tight sm:inline"
          >{PERSONAL_INFO.displayName}</span
        >
      </a>

      <div class="hidden items-center gap-1 lg:flex">
        {
          NAV_ITEMS.map(item => (
            <a
              href={item.href}
              class="rounded-lg px-3 py-1.5 text-body-sm font-medium text-muted-foreground transition-all duration-200 ease-smooth hover:bg-surface-elevated/50 hover:text-foreground"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        <ThemeToggle />

        <button
          class="rounded-xl p-2 text-muted-foreground transition-all hover:bg-accent/5 hover:text-foreground lg:hidden"
          aria-label="Ouvrir le menu"
          data-mobile-menu-toggle
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </button>
      </div>
    </div>

    <div
      class="h-0 overflow-hidden transition-all duration-300 ease-smooth lg:hidden"
      data-mobile-menu
    >
      <div class="space-y-1 border-t border-border/40 py-4">
        {
          NAV_ITEMS.map(item => (
            <a
              href={item.href}
              class="block rounded-xl px-3 py-2.5 text-body-sm font-medium text-muted-foreground transition-all duration-200 ease-smooth hover:bg-accent/5 hover:text-foreground"
            >
              {item.label}
            </a>
          ))
        }
        <div class="border-t border-border/40 pt-3">
          <a
            href={PERSONAL_INFO.cvPath}
            download
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary py-2.5 text-body-sm font-semibold text-primary-foreground"
          >
            <Icon name="lucide:download" class="h-4 w-4" />
            Télécharger mon CV
          </a>
        </div>
      </div>
    </div>
  </nav>

  <script is:inline>
    var toggle = document.querySelector('[data-mobile-menu-toggle]');
    var menu = document.querySelector('[data-mobile-menu]');
    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var isOpen = menu.classList.toggle('h-auto');
        menu.classList.toggle('h-0');
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.remove('h-auto');
          menu.classList.add('h-0');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>
</header>
