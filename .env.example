# Portfolio Premium - Cédric Djiele
# Copier ce fichier vers .env et remplir les valeurs

# Site
PUBLIC_SITE_URL=https://votre-domaine.com
PUBLIC_SITE_NAME="Cédric Djiele — Portfolio"

# Contact Form (optionnel - utiliser Formspree, Netlify Forms, ou API custom)
PUBLIC_CONTACT_ENDPOINT=https://api.votre-domaine.com/contact

# Analytics (optionnel)
# PUBLIC_GA_ID=G-XXXXXXXXXX
# PUBLIC_PLAUSIBLE_DOMAIN=votre-domaine.com

# Social
PUBLIC_GITHUB_URL=https://github.com/votre-username
PUBLIC_LINKEDIN_URL=https://linkedin.com/in/votre-profil
PUBLIC_TWITTER_URL=https://twitter.com/votre-handle
PUBLIC_EMAIL=contact@votre-domaine.com

# TinaCMS (optionnel - pour édition visuelle)
# TINA_CLIENT_ID=xxx
# TINA_TOKEN=xxx